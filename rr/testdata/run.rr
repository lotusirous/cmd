# expect X-Test: yes
-- sends the request headers --
GET {{url}}/ HTTP/1.1
Host: example.com
X-Test: yes

	-- sends the request headers --
	GET {{url}}/ HTTP/1.1
	Host: example.com
	X-Test: yes

	HTTP/1.1 200 OK
	Content-Length: 5
	Content-Type: text/plain

	hello
-- indents a json response --
POST {{url}}/ HTTP/1.1
Host: example.com
Content-Length: 4

body
	-- indents a json response --
	POST {{url}}/ HTTP/1.1
	Host: example.com
	Content-Length: 4

	body
	HTTP/1.1 200 OK
	Content-Length: 26
	Content-Type: application/json

	{
	  "ok": true,
	  "n": 1
	}
-- replaces an old response --
GET {{url}}/ HTTP/1.1
Host: example.com

HTTP/1.1 200 OK
Content-Length: 2
Content-Type: text/plain

v1
	-- replaces an old response --
	GET {{url}}/ HTTP/1.1
	Host: example.com

	HTTP/1.1 200 OK
	Content-Length: 2
	Content-Type: text/plain

	v2
# chunked
# note a chunked response has no length to keep, so it is stored with the length of the body written
-- stores a chunked response plainly --
GET {{url}}/ HTTP/1.1
Host: example.com

	-- stores a chunked response plainly --
	GET {{url}}/ HTTP/1.1
	Host: example.com

	HTTP/1.1 200 OK
	Content-Length: 7
	Content-Type: text/plain

	chunked
# note a hand-written exchange often stops after the last header. The block is
# note ended on the way to the wire and not in the file, which run does not
# note rewrite: rr fmt is what ends it there.
-- sends an exchange that ends after the last header --
GET {{url}}/ HTTP/1.1
Host: example.com
	-- sends an exchange that ends after the last header --
	GET {{url}}/ HTTP/1.1
	Host: example.com
	HTTP/1.1 200 OK
	Content-Length: 5
	Content-Type: text/plain

	hello
# echo
# note http.ReadRequest would drop this body for want of framing
-- frames a body with no length --
POST {{url}}/ HTTP/1.1
Host: example.com
Content-Type: application/json

{"a":1}
	-- frames a body with no length --
	POST {{url}}/ HTTP/1.1
	Host: example.com
	Content-Type: application/json

	{"a":1}
	HTTP/1.1 200 OK
	Content-Length: 7
	Content-Type: text/plain

	{"a":1}
# echo
# note ... and would send only the first two bytes of it here. Rr frames the
# note body itself, so the length the file holds is ignored on the wire and
# note kept on disk until rr fmt drops it.
-- ignores a stale content-length --
POST {{url}}/ HTTP/1.1
Host: example.com
Content-Length: 2

{"a":1}
	-- ignores a stale content-length --
	POST {{url}}/ HTTP/1.1
	Host: example.com
	Content-Length: 2

	{"a":1}
	HTTP/1.1 200 OK
	Content-Length: 7
	Content-Type: text/plain

	{"a":1}
# note the body parses as JSON, but text/plain says it is not one
-- indents only what says it is json --
GET {{url}}/ HTTP/1.1
Host: example.com

	-- indents only what says it is json --
	GET {{url}}/ HTTP/1.1
	Host: example.com

	HTTP/1.1 200 OK
	Content-Length: 7
	Content-Type: text/plain

	{"a":1}
# note an absolute request URI carries the host, so Host is optional
-- needs no host header --
GET {{url}}/ HTTP/1.1

	-- needs no host header --
	GET {{url}}/ HTTP/1.1

	HTTP/1.1 200 OK
	Content-Length: 5
	Content-Type: text/plain

	hello
# echo
# note a run rewrites the answer and nothing else. The lower-case method, the
# note unspaced header and the unindented body are the file's own text, and rr
# note fmt is what makes them canonical.
-- sends the request as the file writes it --
post {{url}}/ HTTP/1.1
content-type:application/json
content-length: 2
X-EMPTY:	

{"a":1}
	-- sends the request as the file writes it --
	post {{url}}/ HTTP/1.1
	content-type:application/json
	content-length: 2
	X-EMPTY:	

	{"a":1}
	HTTP/1.1 200 OK
	Content-Length: 7
	Content-Type: text/plain

	{"a":1}
what this file is for

-- keeps the comment --
GET {{url}}/ HTTP/1.1

	what this file is for

	-- keeps the comment --
	GET {{url}}/ HTTP/1.1

	HTTP/1.1 200 OK
	Content-Length: 2
	Content-Type: text/plain

	ok
# env TOKEN=secret
# expect Authorization: Bearer secret
# note what is sent carries the value; what is stored keeps the variable, so the file stays safe to commit
-- keeps variables on disk --
GET {{url}}/ HTTP/1.1
Host: example.com
Authorization: Bearer ${TOKEN}

	-- keeps variables on disk --
	GET {{url}}/ HTTP/1.1
	Host: example.com
	Authorization: Bearer ${TOKEN}

	HTTP/1.1 200 OK
	Content-Length: 2
	Content-Type: text/plain

	ok
# note a file is a collection: every exchange is sent, in the order the file has them
-- sends every exchange in order --
GET {{url}}/a HTTP/1.1

-- two --
GET {{url}}/b HTTP/1.1

	-- sends every exchange in order --
	GET {{url}}/a HTTP/1.1

	HTTP/1.1 200 OK
	Content-Length: 1
	Content-Type: text/plain

	a
	-- two --
	GET {{url}}/b HTTP/1.1

	HTTP/1.1 200 OK
	Content-Length: 1
	Content-Type: text/plain

	b
